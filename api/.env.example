# AI Provider Configuration
# Choose between 'claude', 'ollama', or 'lmstudio'
AI_PROVIDER=claude

# Claude Configuration (required if AI_PROVIDER=claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Ollama Configuration (required if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434 # Adjust if Ollama is running on a different host/port
OLLAMA_MODEL=mistral-small # Name of the Ollama model to use, make sure you have it downloaded

# LM Studio Configuration (required if AI_PROVIDER=lmstudio)
# Start the local server in LM Studio (Developer tab > Start Server) and load a model that supports tool/function calling.
LM_STUDIO_BASE_URL=http://localhost:1234/v1 # LM Studio's OpenAI-compatible server URL, must include /v1
LM_STUDIO_MODEL=local-model # Must match the model identifier shown in LM Studio's server logs/API
LM_STUDIO_API_KEY=lm-studio # LM Studio does not check this; any non-empty string works

# Server Configuration
PORT=8080

# Prompt Configuration
# Name of the system prompt file (without .md extension) from api/prompts/ directory
SYSTEM_PROMPT=default
# Assistant name variable used in system prompts. This is for demonstration and can be customized or removed if it does not fit your use case.
ASSISTANT_NAME=AI Assistant
